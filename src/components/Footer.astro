---
// Footer.astro
import { ArrowRight, MessageSquare, Mail, MapPin, Handshake } from 'lucide-astro';
---

<footer class="footer-clean">
  <div class="container">
    <!-- High-Impact Navy CTA Banner (Partnership & Collaboration Focus) -->
    <div class="cta-banner">
      <h2 class="cta-title">
        Mari Bermitra untuk Membantu <br>
        <span>Lebih Banyak UMKM Indonesia Naik Kelas</span>
      </h2>
      <p class="cta-desc">
        Diskusikan potensi kolaborasi kemitraan, implementasi digitalisasi bisnis mandiri, atau program pembinaan komunitas Anda bersama tim Aksara Developer hari ini.
      </p>
      <div style="display:flex; justify-content:center; gap:16px; flex-wrap:wrap;">
        <a href="https://wa.me/6281234567890?text=Halo%20Aksara%20Developer,%20saya%20tertarik%20untuk%20diskusi%20kemitraan%20dan%20kolaborasi%20digitalisasi%20UMKM" target="_blank" class="btn-primary magnetic-btn" data-cursor="KOLABORASI">
          <Handshake size={18} />
          <span>Diskusikan Kemitraan via WhatsApp</span>
          <ArrowRight size={18} stroke-width={2.2} />
        </a>
        <a href="#kemitraan" class="btn-secondary magnetic-btn" data-cursor="SKEMA">
          <span>Lihat Skema Kerjasama</span>
        </a>
      </div>
    </div>

    <!-- 4-Column Modern Clean Footer -->
    <div class="footer-top">
      <div>
        <div class="brand" style="margin-bottom:12px; display:flex; align-items:center; gap:10px;">
          <img src="/assets/Logo-AD-Transparan.png" alt="Aksara Developer Logo" class="brand-logo-img" />
          <div class="brand-name">AKSARA DEVELOPER</div>
        </div>
        <p class="footer-brand-desc">
          Mitra rekayasa solusi digital mandiri dan kolaborasi strategis khusus Usaha Mikro, Kecil, dan Menengah (UMKM) di Indonesia. Cepat, berdampak nyata, dan bebas potongan komisi selamanya.
        </p>
      </div>

      <div class="footer-col">
        <h5>Solusi Ekosistem</h5>
        <ul class="footer-links">
          <li><a href="#solusi">Katalog WhatsApp Mandiri</a></li>
          <li><a href="#solusi">Aplikasi Kasir (POS) Cloud</a></li>
          <li><a href="#solusi">Company Profile &amp; Local SEO</a></li>
          <li><a href="#solusi">Sistem Operasional Kustom</a></li>
        </ul>
      </div>

      <div class="footer-col">
        <h5>Kemitraan &amp; Manfaat</h5>
        <ul class="footer-links">
          <li><a href="#benefit">Nilai Tambah &amp; Benefit UMKM</a></li>
          <li><a href="#kemitraan">Mitra Komunitas &amp; Asosiasi</a></li>
          <li><a href="#kemitraan">Mitra Brand Owner &amp; Bisnis</a></li>
          <li><a href="#kemitraan">Mitra Agensi &amp; Reseller</a></li>
          <li><a href="#faq">Pusat Bantuan &amp; FAQ</a></li>
        </ul>
      </div>

      <div class="footer-col">
        <h5>Kontak Kemitraan</h5>
        <ul class="footer-links">
          <li>
            <a href="https://wa.me/6281234567890" target="_blank" style="display:inline-flex; align-items:center; gap:8px;">
              <MessageSquare size={14} color="var(--wa-green)" />
              <span>WhatsApp: +62 812-3456-7890</span>
            </a>
          </li>
          <li>
            <a href="mailto:mitra@aksaradeveloper.id" style="display:inline-flex; align-items:center; gap:8px;">
              <Mail size={14} color="var(--steel-primary)" />
              <span>Email: mitra@aksaradeveloper.id</span>
            </a>
          </li>
          <li>
            <span style="color:var(--text-body); font-size:14px; display:inline-flex; align-items:center; gap:8px;">
              <MapPin size={14} color="var(--gold-dark)" />
              <span>Surabaya &bull; Jakarta &bull; Seluruh Indonesia</span>
            </span>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom Copyright -->
    <div class="footer-bottom">
      <div>
        &copy; 2026 <strong>Aksara Developer</strong>. Seluruh Hak Cipta Dilindungi Undang-Undang.
      </div>
      <div>
        Sinergi Kemitraan Mandiri Memajukan UMKM Indonesia Menuju Masa Depan Digital.
      </div>
    </div>
  </div>
</footer>
