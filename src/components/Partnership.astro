---
// Partnership.astro
import { 
  Handshake, 
  Users2, 
  Building2, 
  Briefcase, 
  ArrowRight, 
  CheckCircle2, 
  MessageSquare,
  Sparkles,
  Workflow
} from 'lucide-astro';
---

<section id="kemitraan" class="section container">
  <div class="section-header">
    <div class="section-tag">Program Kemitraan Strategis</div>
    <h2 class="section-title">Mari Bertumbuh Bersama: Kolaborasi Mitra Digitalisasi UMKM</h2>
    <p class="section-description">
      Kami membuka pintu kolaborasi seluas-luasnya untuk asosiasi usaha, pemilik bisnis, dan konsultan yang ingin mempercepat kemandirian ekonomi digital Indonesia.
    </p>
  </div>

  <!-- 3 Model Kemitraan -->
  <div class="partner-models-grid">
    <!-- Model 1 -->
    <div class="partner-model-card">
      <div class="partner-badge">Skema 01</div>
      <div class="partner-icon-box">
        <Users2 size={26} stroke-width={2} />
      </div>
      <h4>Mitra Komunitas &amp; Asosiasi UMKM</h4>
      <p>
        Program kolaborasi khusus untuk paguyuban wirausaha, dinas koperasi, dan inkubator bisnis. Kami menyediakan pendampingan kelompok, workshop digitalisasi, dan penerapan sistem serentak untuk anggota binaan Anda.
      </p>
      <ul class="partner-bullets">
        <li>
          <CheckCircle2 size={15} color="var(--wa-green)" />
          <span>Workshop &amp; pelatihan digitalisasi anggota</span>
        </li>
        <li>
          <CheckCircle2 size={15} color="var(--wa-green)" />
          <span>Paket kolektif ramah anggaran komunitas</span>
        </li>
        <li>
          <CheckCircle2 size={15} color="var(--wa-green)" />
          <span>Laporan evaluasi adopsi teknologi berkala</span>
        </li>
      </ul>
      <a href="https://wa.me/6281234567890?text=Halo%20Aksara%20Developer,%20saya%20ingin%20diskusi%20kemitraan%20untuk%20komunitas/asosiasi%20UMKM" target="_blank" class="partner-link magnetic-btn" data-cursor="KOLABORASI">
        <span>Ajukan Kemitraan Komunitas</span>
        <ArrowRight size={14} />
      </a>
    </div>

    <!-- Model 2 (Unggulan) -->
    <div class="partner-model-card partner-featured">
      <div class="partner-badge" style="background:var(--gold-primary); color:var(--navy-deep);">Rekomendasi Utama</div>
      <div class="partner-icon-box" style="background:var(--navy-deep); color:var(--gold-primary);">
        <Building2 size={26} stroke-width={2} />
      </div>
      <h4>Mitra Brand Owner &amp; Pengusaha Mandiri</h4>
      <p>
        Bagi Anda pemilik tunggal, kedai kuliner, butik retail, atau multi-cabang yang ingin memiliki platform penjualan mandiri dengan integrasi WhatsApp, kasir POS thermal, dan identitas brand profesional tanpa potongan komisi pihak ketiga.
      </p>
      <ul class="partner-bullets">
        <li>
          <CheckCircle2 size={15} color="var(--wa-green)" />
          <span>Sistem kustom sesuai SOP operasional toko</span>
        </li>
        <li>
          <CheckCircle2 size={15} color="var(--wa-green)" />
          <span>Setup kilat 3–7 hari siap langsung jualan</span>
        </li>
        <li>
          <CheckCircle2 size={15} color="var(--wa-green)" />
          <span>Pendampingan staf privat sampai mahir</span>
        </li>
      </ul>
      <a href="https://wa.me/6281234567890?text=Halo%20Aksara%20Developer,%20saya%20tertarik%20kerjasama%20digitalisasi%20untuk%20bisnis%20saya" target="_blank" class="btn-primary magnetic-btn" style="width:100%; text-align:center; margin-top:auto;" data-cursor="KEMITRAAN">
        <span>Konsultasi Kemitraan Bisnis</span>
        <ArrowRight size={16} />
      </a>
    </div>

    <!-- Model 3 -->
    <div class="partner-model-card">
      <div class="partner-badge">Skema 03</div>
      <div class="partner-icon-box">
        <Briefcase size={26} stroke-width={2} />
      </div>
      <h4>Mitra Agensi, Konsultan &amp; Reseller</h4>
      <p>
        Bagi konsultan bisnis, agensi digital marketing, atau freelancer yang ingin melengkapi portofolio layanan dengan menyediakan sistem katalog dan POS berkualitas tinggi kepada jaringan klien UMKM Anda.
      </p>
      <ul class="partner-bullets">
        <li>
          <CheckCircle2 size={15} color="var(--wa-green)" />
          <span>Sistem bagi hasil kemitraan yang transparan</span>
        </li>
        <li>
          <CheckCircle2 size={15} color="var(--wa-green)" />
          <span>Dukungan teknis penuh dari tim engineer Aksara</span>
        </li>
        <li>
          <CheckCircle2 size={15} color="var(--wa-green)" />
          <span>Materi presentasi &amp; demo siap pakai</span>
        </li>
      </ul>
      <a href="https://wa.me/6281234567890?text=Halo%20Aksara%20Developer,%20saya%20ingin%20bergabung%20sebagai%20mitra%20agensi/reseller" target="_blank" class="partner-link magnetic-btn" data-cursor="PARTNER">
        <span>Gabung Sebagai Mitra Agensi</span>
        <ArrowRight size={14} />
      </a>
    </div>
  </div>

  <!-- Alur Kerjasama Mitra (4 Langkah Praktis) -->
  <div class="workflow-box">
    <div style="text-align:center; max-width:640px; margin:0 auto 40px auto;">
      <div style="font-size:12px; font-weight:700; text-transform:uppercase; color:var(--gold-dark); letter-spacing:0.08em; margin-bottom:8px;">Proses Kolaborasi</div>
      <h3 style="font-size:28px; font-weight:800; color:var(--navy-deep);">4 Langkah Mudah Menjalin Kerjasama</h3>
    </div>

    <div class="workflow-steps">
      <div class="step-card">
        <div class="step-number">01</div>
        <h5>Diskusi Kebutuhan</h5>
        <p>Konsultasi santai via WhatsApp untuk memetakan alur bisnis, kendala kasir, atau katalog produk Anda.</p>
      </div>

      <div class="step-card">
        <div class="step-number">02</div>
        <h5>Perancangan Solusi</h5>
        <p>Tim Aksara merancang arsitektur sistem yang pas dengan identitas brand dan alur operasional tim Anda.</p>
      </div>

      <div class="step-card">
        <div class="step-number">03</div>
        <h5>Pelatihan &amp; Uji Coba</h5>
        <p>Staf dan kasir Anda dilatih langsung menggunakan simulasi nyata hingga seluruh alur dikuasai.</p>
      </div>

      <div class="step-card">
        <div class="step-number">04</div>
        <h5>Go-Live &amp; Garansi</h5>
        <p>Sistem diluncurkan ke pelanggan dengan dukungan teknis dan garansi pendampingan berkelanjutan.</p>
      </div>
    </div>
  </div>
</section>

