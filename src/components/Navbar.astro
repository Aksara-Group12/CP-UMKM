---
// Navbar.astro
import { Sparkles, ArrowRight } from 'lucide-astro';
---

<!-- Top Announcement Bar (Full Width like Mayar) -->
<div class="top-bar">
  <div class="container" style="display:flex; align-items:center; justify-content:center; gap:8px;">
    <Sparkles size={14} color="var(--gold-primary)" />
    <span><strong>Program Kemitraan UMKM:</strong> Buka peluang kolaborasi digitalisasi bisnis bersama Aksara Inovatif.</span>
    <a href="#kemitraan" class="magnetic-btn" data-cursor="MITRA" style="display:inline-flex; align-items:center; gap:4px; margin-left:6px;">
      <span>Pelajari Skema Kerjasama</span>
      <ArrowRight size={13} />
    </a>
  </div>
</div>

<!-- Header Full-Width (Bebas / Seamless seperti Mayar, Bukan Floating Card) -->
<header class="site-header">
  <div class="container header-inner">
    <a href="#" class="brand magnetic-btn" data-cursor="AKSARA">
      <img src="/assets/Logo-AD-Transparan.png" alt="Aksara Inovatif" class="brand-logo-img" />
      <span class="brand-name">AKSARA INOVATIF</span>
    </a>

    <ul class="nav-links">
      <li>
        <a href="#solusi" class="nav-link rolling-text" data-cursor="LIHAT">
          <span>Solusi Digital</span>
          <span>Solusi Digital</span>
        </a>
      </li>
      <li>
        <a href="#showroom" class="nav-link rolling-text" data-cursor="DEMO">
          <span>Showroom Demo</span>
          <span>Showroom Demo</span>
        </a>
      </li>
      <li>
        <a href="#benefit" class="nav-link rolling-text" data-cursor="MANFAAT">
          <span>Benefit UMKM</span>
          <span>Benefit UMKM</span>
        </a>
      </li>
      <li>
        <a href="#kemitraan" class="nav-link rolling-text" data-cursor="KOLABORASI">
          <span>Kerjasama Mitra</span>
          <span>Kerjasama Mitra</span>
        </a>
      </li>
      <li>
        <a href="#perbandingan" class="nav-link rolling-text" data-cursor="KEUNGGULAN">
          <span>Keunggulan</span>
          <span>Keunggulan</span>
        </a>
      </li>
      <li>
        <a href="#faq" class="nav-link rolling-text" data-cursor="TANYA">
          <span>FAQ</span>
          <span>FAQ</span>
        </a>
      </li>
    </ul>

    <div class="nav-actions">
      <a href="https://wa.me/6281234567890?text=Halo%20Aksara%20Inovatif,%20saya%20ingin%20tanya-tanya%20seputar%20peluang%20kerjasama%20mitra%20UMKM" target="_blank" rel="noopener" class="btn-ghost magnetic-btn" data-cursor="TANYA">
        Tanya CS
      </a>
      <a href="https://wa.me/6281234567890?text=Halo%20Aksara%20Inovatif,%20saya%20ingin%20konsultasi%20program%20kemitraan%20dan%20solusi%20digital%20UMKM" target="_blank" rel="noopener" class="btn-nav-cta magnetic-btn" data-cursor="KEMITRAAN">
        <span>Ajukan Kerjasama</span>
        <ArrowRight size={14} stroke-width={2.2} />
      </a>
    </div>
  </div>
</header>
