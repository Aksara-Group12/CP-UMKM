---
// Showroom.astro
import { ShoppingBag, Receipt, Globe, Check, ArrowRight } from 'lucide-astro';
---

<section id="showroom" class="section container">
  <div class="section-header">
    <div class="section-tag">Showroom Solusi</div>
    <h2 class="section-title">Bagaimana Sistem Bekerja untuk Bisnis Anda</h2>
    <p class="section-description">
      Ringkasan alur operasional dan manfaat nyata dari setiap solusi digital mandiri Aksara Developer.
    </p>
  </div>

  <div class="showcase-container">
    <!-- Interactive Tabs -->
    <div class="showcase-tabs">
      <button class="tab-btn active" data-tab="katalog" style="display:inline-flex; align-items:center; gap:8px;">
        <ShoppingBag size={16} />
        <span>Katalog &amp; Order WhatsApp</span>
      </button>
      <button class="tab-btn" data-tab="kasir" style="display:inline-flex; align-items:center; gap:8px;">
        <Receipt size={16} />
        <span>Aplikasi Kasir (POS) Cloud</span>
      </button>
      <button class="tab-btn" data-tab="compro" style="display:inline-flex; align-items:center; gap:8px;">
        <Globe size={16} />
        <span>Company Profile &amp; SEO Lokal</span>
      </button>
    </div>

    <div class="showcase-grid">
      <!-- Left Column: Overview & Deliverables -->
      <div class="showcase-info">
        <h3 id="showcase-title">Katalog Produk &amp; Checkout WhatsApp</h3>
        <p id="showcase-desc">
          Ubah akun media sosial atau toko fisik Anda menjadi platform pemesanan instan. Pelanggan memilih varian produk, hitung ongkir otomatis, dan langsung checkout ke WhatsApp kasir tanpa potongan fee marketplace.
        </p>
        <ul class="feature-bullets" id="showcase-bullets">
          <li>
            <span class="bullet-icon">
              <Check size={13} stroke-width={3} />
            </span>
            <span>Load instan &lt; 1 detik di koneksi 4G/3G ponsel pelanggan</span>
          </li>
          <li>
            <span class="bullet-icon">
              <Check size={13} stroke-width={3} />
            </span>
            <span>Integrasi tombol pesan WhatsApp langsung dengan rincian nota siap proses</span>
          </li>
          <li>
            <span class="bullet-icon">
              <Check size={13} stroke-width={3} />
            </span>
            <span>Manajemen varian produk &amp; stok mudah diupdate lewat HP</span>
          </li>
          <li>
            <span class="bullet-icon">
              <Check size={13} stroke-width={3} />
            </span>
            <span>Tanpa potongan komisi penjualan 10% - 20% sepeser pun</span>
          </li>
        </ul>
        <a id="showcase-cta" href="https://wa.me/628131355613?text=Halo%20Aksara%20Developer,%20saya%20tertarik%20dengan%20sistem%20Katalog%20WhatsApp" target="_blank" class="btn-primary">
          <span>Konsultasi Solusi Ini</span>
          <ArrowRight size={16} />
        </a>
      </div>

      <!-- Right Column: Concise Clean Text Explanation (No Dummy Mockup Card) -->
      <div class="showcase-summary-card">
        <div class="summary-card-header">
          <span class="summary-card-label" id="summary-badge">Alur Operasional</span>
          <span class="summary-target-label" id="summary-target">Pelanggan &rarr; Kasir WhatsApp</span>
        </div>
        
        <div id="showcase-dynamic-steps" class="workflow-mini-list">
          <div class="workflow-mini-item">
            <div class="mini-step-badge">1</div>
            <div>
              <strong>Pelanggan Akses Link Langsung</strong>
              <p>Membuka katalog dari link bio Instagram, TikTok, atau scan QR code meja tanpa install aplikasi.</p>
            </div>
          </div>
          <div class="workflow-mini-item">
            <div class="mini-step-badge">2</div>
            <div>
              <strong>Pilih Varian &amp; Hitung Ongkir</strong>
              <p>Pelanggan menentukan opsi rasa, ukuran, dan alamat pengiriman dengan kalkulasi total instan.</p>
            </div>
          </div>
          <div class="workflow-mini-item">
            <div class="mini-step-badge">3</div>
            <div>
              <strong>Format Pesanan Masuk ke WhatsApp</strong>
              <p>Rincian order otomatis terformat rapi menjadi nota di WhatsApp toko, siap dikonfirmasi kasir.</p>
            </div>
          </div>
        </div>

        <div class="summary-card-footer" id="showcase-dynamic-footer">
          <div class="takeaway-badge">Kedaulatan Bisnis</div>
          <div class="takeaway-text">100% margin omzet masuk rekening toko &bull; Database kontak pembeli tersimpan mandiri.</div>
        </div>
      </div>
    </div>
  </div>
</section>
