---
// Showroom.astro
---

<section id="showroom" class="section container">
  <div class="section-header">
    <div class="section-tag">Showroom Interaktif</div>
    <h2 class="section-title">Solusi yang Dirancang Khusus untuk Alur Kerja Bisnis Nyata Anda</h2>
  </div>

  <div class="showcase-container">
    <!-- Interactive Tabs -->
    <div class="showcase-tabs">
      <button class="tab-btn active magnetic-btn" data-tab="katalog" data-cursor="PILIH">🛍️ Katalog WhatsApp</button>
      <button class="tab-btn magnetic-btn" data-tab="kasir" data-cursor="PILIH">📊 Kasir &amp; Stok POS</button>
      <button class="tab-btn magnetic-btn" data-tab="compro" data-cursor="PILIH">🌐 Company Profile Resmi</button>
    </div>

    <div class="showcase-grid">
      <!-- Text Info -->
      <div class="showcase-info">
        <h3 id="showcase-title">Katalog Produk &amp; Checkout WhatsApp</h3>
        <p id="showcase-desc">
          Ubah akun media sosial atau toko fisik Anda menjadi platform pemesanan instan. Pelanggan memilih varian produk, hitung ongkir otomatis, dan langsung checkout ke WhatsApp kasir tanpa potongan fee marketplace.
        </p>
        <ul class="feature-bullets" id="showcase-bullets">
          <li>
            <span class="bullet-icon">✓</span>
            <span>Load instan &lt; 1 detik di koneksi 4G/3G ponsel</span>
          </li>
          <li>
            <span class="bullet-icon">✓</span>
            <span>Integrasi tombol pesan WhatsApp langsung dengan rincian order</span>
          </li>
          <li>
            <span class="bullet-icon">✓</span>
            <span>Manajemen varian produk &amp; stok mudah lewat HP</span>
          </li>
          <li>
            <span class="bullet-icon">✓</span>
            <span>Tanpa biaya komisi penjualan sepeser pun</span>
          </li>
        </ul>
        <a href="https://wa.me/6281234567890?text=Halo%20Aksara,%20saya%20tertarik%20dengan%20sistem%20Katalog%20WhatsApp" class="btn-primary magnetic-btn" data-cursor="TANYA WA">
          <span>Konsultasi Solusi Ini</span>
        </a>
      </div>

      <!-- Dynamic Mockup Preview -->
      <div class="device-mockup" data-cursor="PREVIEW">
        <div class="mockup-header">
          <div class="mockup-dots">
            <span></span><span></span><span></span>
          </div>
          <div class="mockup-title-bar" id="mockup-url">aksara-katalog-order.app</div>
          <span class="brand-tag" id="mockup-badge">Checkout WhatsApp Aktif</span>
        </div>

        <div class="mockup-content">
          <div style="font-size:12px; color:#cfa86e; font-weight:700; text-transform:uppercase; letter-spacing:0.05em; margin-bottom:12px;" id="mockup-card-title">
            Katalog Kuliner &amp; Retail UMKM
          </div>
          <div id="mockup-dynamic-content">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:16px;">
              <span style="font-weight:700; color:#faebd2;">Kopi Susu Gula Aren (1 Liter)</span>
              <span style="color:#cfa86e; font-weight:800;">Rp 75.000</span>
            </div>
            <div style="background:#0e2742; border:1px solid #3b74a3; border-radius:12px; padding:12px; margin-bottom:14px; font-size:13px; color:#95acc0;">
              ⚡ Pilihan Varian: Less Sugar • Normal Ice
            </div>
            <div style="background:linear-gradient(135deg, #10b981, #059669); color:#fff; border-radius:10px; padding:12px; text-align:center; font-weight:700; font-size:13px;">
              💬 Kirim Rincian Pesanan ke WhatsApp Penjual
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
