---
// Calculator.astro
import { ArrowRight, Clock, ShieldCheck, ShoppingBag, Receipt, Globe, Settings2, Check } from 'lucide-astro';
---

<section id="kalkulator" class="section container">
  <div class="section-header">
    <div class="section-tag">Simulator Biaya Investasi</div>
    <h2 class="section-title">Kalkulator Estimasi Biaya &amp; Paket Solusi UMKM</h2>
    <p class="section-description">
      Pilih solusi yang Anda butuhkan, sesuaikan fitur tambahan, dan dapatkan estimasi biaya transparan tanpa biaya siluman.
    </p>
  </div>

  <div class="calc-card">
    <div class="calc-grid">
      <!-- Options Left Side -->
      <div>
        <div class="calc-group">
          <label class="calc-label">1. Pilih Kategori Solusi Bisnis Utama</label>
          <div class="calc-chips">
            <button class="chip-btn chip-type active magnetic-btn" data-value="katalog">
              <span>Katalog WA Order</span>
            </button>
            <button class="chip-btn chip-type magnetic-btn" data-value="kasir">
              <span>Aplikasi Kasir POS</span>
            </button>
            <button class="chip-btn chip-type magnetic-btn" data-value="compro">
              <span>Company Profile</span>
            </button>
            <button class="chip-btn chip-type magnetic-btn" data-value="custom">
              <span>Sistem Kustom</span>
            </button>
          </div>
        </div>

        <div class="calc-group">
          <label class="calc-label">2. Fasilitas Pendukung &amp; Add-on</label>
          <div class="calc-chips">
            <button class="chip-btn chip-addon active magnetic-btn" data-value="wa">
              <span>Integrasi WhatsApp (Gratis)</span>
            </button>
            <button class="chip-btn chip-addon active magnetic-btn" data-value="domain">
              <span>Domain .COM + Hosting 1 Thn (+350rb)</span>
            </button>
            <button class="chip-btn chip-addon magnetic-btn" data-value="seo">
              <span>Google Maps &amp; SEO Lokal (+400rb)</span>
            </button>
            <button class="chip-btn chip-addon magnetic-btn" data-value="training">
              <span>Bimbingan Staf &amp; Garansi (+250rb)</span>
            </button>
          </div>
        </div>

        <div style="background:var(--bg-main); border:1px solid var(--border-warm); border-radius:12px; padding:16px; font-size:13px; color:var(--text-body); line-height:1.6; display:flex; align-items:flex-start; gap:10px;">
          <ShieldCheck size={20} color="var(--steel-primary)" style="flex-shrink:0; margin-top:2px;" />
          <div>
            <strong>Jaminan Aksara:</strong> Sistem 100% menjadi hak milik usaha Anda, tanpa tagihan komisi penjualan bulanan, dan langsung siap dipakai jualan.
          </div>
        </div>
      </div>

      <!-- Summary Box Right Side -->
      <div class="calc-summary">
        <div>
          <div class="summary-price-label">Estimasi Total Investasi</div>
          <div class="summary-price-val" id="calc-total">Rp 1.800.000</div>

          <div class="summary-timeline">
            <Clock size={15} color="var(--gold-dark)" />
            <span>Waktu Pengerjaan:</span>
            <strong id="calc-timeline" style="color:var(--navy-deep);">3-5 Hari Kerja</strong>
          </div>

          <div style="font-size:12px; font-weight:700; text-transform:uppercase; color:var(--text-muted); margin-bottom:10px;">Fitur yang Didapatkan:</div>
          <ul class="summary-features" id="calc-features-list">
            <!-- Dynamic elements populated via main.js -->
          </ul>
        </div>

        <a href="#" id="calc-wa-btn" target="_blank" class="btn-primary magnetic-btn" style="width:100%; text-align:center;" data-cursor="PESAN WA">
          <span>Kirim Rincian &amp; Diskusi via WhatsApp</span>
          <ArrowRight size={18} stroke-width={2.2} />
        </a>
      </div>
    </div>
  </div>
</section>
