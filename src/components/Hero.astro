---
// Hero.astro
import { 
  ArrowRight, 
  UtensilsCrossed, 
  Shirt, 
  Store, 
  Wrench, 
  Truck,
  Handshake
} from 'lucide-astro';
---

<section class="hero container">
  <!-- Hero Main Headline -->
  <h1 class="hero-title">
    Kolaborasi Strategis Menuju Kemandirian Digital UMKM <span class="highlight-gold">Naik Kelas</span> &amp; <span class="highlight-steel">Melesat Cepat.</span>
  </h1>

  <!-- Hero Subheadline -->
  <p class="hero-description">
    Aksara Developer hadir sebagai mitra teknologi yang mendampingi pengusaha, komunitas, dan asosiasi bisnis membangun sistem penjualan mandiri. Bebas potongan komisi pihak ketiga, 100% hak milik usaha Anda, dan didampingi hingga tim Anda mahir.
  </p>

  <!-- CTA Buttons -->
  <div class="hero-actions">
    <a href="#kemitraan" class="btn-primary" data-cursor="KOLABORASI">
      <Handshake size={18} stroke-width={2.2} />
      <span>Jelajahi Skema Kemitraan Mitra</span>
      <ArrowRight size={18} stroke-width={2.2} />
    </a>
    <a href="https://wa.me/628131355613?text=Halo%20Aksara%20Developer,%20saya%20ingin%20konsultasi%20program%20kemitraan%20dan%20solusi%20digital%20UMKM" target="_blank" rel="noopener" class="btn-secondary">
      <span>Konsultasi Langsung via WhatsApp</span>
    </a>
  </div>

  <!-- Social Proof Continuous Ticker (Bergerak menyambung dari kiri ke kanan) -->
  <div class="social-proof-strip">
    <div class="social-proof-label">Telah Mendukung Pertumbuhan Kemitraan Berbagai Sektor Usaha</div>
    <div class="marquee-wrapper">
      <div class="marquee-track">
        <!-- Set 1 -->
        <div class="proof-tag-item">
          <UtensilsCrossed size={15} color="var(--steel-primary)" />
          <span>F&amp;B, Cafe &amp; Restoran</span>
        </div>
        <div class="proof-tag-item">
          <Shirt size={15} color="var(--gold-dark)" />
          <span>Butik, Fashion &amp; Hijab</span>
        </div>
        <div class="proof-tag-item">
          <Store size={15} color="var(--steel-primary)" />
          <span>Toko Kelontong &amp; Retail</span>
        </div>
        <div class="proof-tag-item">
          <Wrench size={15} color="var(--gold-dark)" />
          <span>Bengkel, Salon &amp; Jasa</span>
        </div>
        <div class="proof-tag-item">
          <Truck size={15} color="var(--steel-primary)" />
          <span>Supplier &amp; Distributor Lokal</span>
        </div>
        <!-- Set 2 -->
        <div class="proof-tag-item">
          <UtensilsCrossed size={15} color="var(--steel-primary)" />
          <span>F&amp;B, Cafe &amp; Restoran</span>
        </div>
        <div class="proof-tag-item">
          <Shirt size={15} color="var(--gold-dark)" />
          <span>Butik, Fashion &amp; Hijab</span>
        </div>
        <div class="proof-tag-item">
          <Store size={15} color="var(--steel-primary)" />
          <span>Toko Kelontong &amp; Retail</span>
        </div>
        <div class="proof-tag-item">
          <Wrench size={15} color="var(--gold-dark)" />
          <span>Bengkel, Salon &amp; Jasa</span>
        </div>
        <div class="proof-tag-item">
          <Truck size={15} color="var(--steel-primary)" />
          <span>Supplier &amp; Distributor Lokal</span>
        </div>
        <!-- Set 3 -->
        <div class="proof-tag-item">
          <UtensilsCrossed size={15} color="var(--steel-primary)" />
          <span>F&amp;B, Cafe &amp; Restoran</span>
        </div>
        <div class="proof-tag-item">
          <Shirt size={15} color="var(--gold-dark)" />
          <span>Butik, Fashion &amp; Hijab</span>
        </div>
        <div class="proof-tag-item">
          <Store size={15} color="var(--steel-primary)" />
          <span>Toko Kelontong &amp; Retail</span>
        </div>
        <div class="proof-tag-item">
          <Wrench size={15} color="var(--gold-dark)" />
          <span>Bengkel, Salon &amp; Jasa</span>
        </div>
        <div class="proof-tag-item">
          <Truck size={15} color="var(--steel-primary)" />
          <span>Supplier &amp; Distributor Lokal</span>
        </div>
      </div>
    </div>
  </div>
</section>
