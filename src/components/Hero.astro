---
// Hero.astro
---

<section class="hero container">
  <div class="hero-pill">
    <span class="hero-pill-indicator"></span>
    <span class="hero-pill-text">Mitra Teknologi Mandiri untuk 50+ UMKM di Indonesia</span>
  </div>

  <h1 class="hero-title">
    Senjata Digital Modern untuk UMKM <span class="highlight-gold">Naik Kelas</span> &amp; <span class="highlight-steel">Melesat Cepat.</span>
  </h1>

  <p class="hero-description">
    Miliki website katalog pesanan WhatsApp, aplikasi kasir (POS), dan profil bisnis resmi tanpa biaya komisi platform, tanpa biaya tersembunyi, dan lengkap dengan pendampingan sampai tim Anda mahir.
  </p>

  <div class="hero-actions">
    <a href="#kalkulator" class="btn-primary magnetic-btn" data-cursor="HITUNG">
      <span>Hitung Estimasi Biaya Usaha Anda</span>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
    </a>
    <a href="#showroom" class="btn-secondary magnetic-btn" data-cursor="JELAJAH">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><polygon points="5 3 19 12 5 21 5 3"/></svg>
      <span>Uji Coba Demo Sistem</span>
    </a>
  </div>

  <div class="hero-stats">
    <div class="stat-item">
      <div class="stat-number">100%</div>
      <div class="stat-label">Kepemilikan Penuh (Bebas Komisi Fee)</div>
    </div>
    <div class="stat-item">
      <div class="stat-number">&lt; 1 Detik</div>
      <div class="stat-label">Kecepatan Buka di HP Konsumen</div>
    </div>
    <div class="stat-item">
      <div class="stat-number">3-7 Hari</div>
      <div class="stat-label">Sistem Siap Digunakan Jualan</div>
    </div>
    <div class="stat-item">
      <div class="stat-number">24/7</div>
      <div class="stat-label">Dukungan &amp; Garansi Maintenance</div>
    </div>
  </div>
</section>
