---
// BentoServices.astro
import { ShoppingBag, Receipt, Globe, Settings2, Check } from 'lucide-astro';
---

<section id="solusi" class="section container">
  <div class="section-header">
    <div class="section-tag">Layanan Ekosistem UMKM</div>
    <h2 class="section-title">Pilar Transformasi Digital Mandiri Tanpa Biaya Tersembunyi</h2>
    <p class="section-description">
      Empat fondasi teknologi terpadu yang dirancang untuk mengatasi hambatan operasional dan mempercepat perputaran omzet usaha Anda.
    </p>
  </div>

  <div class="bento-grid">
    <!-- Card 1 -->
    <div class="bento-card">
      <div>
        <div class="bento-card-top">
          <span class="bento-index">01 / SISTEM PEMESANAN</span>
          <div class="bento-icon-clean">
            <ShoppingBag size={20} stroke-width={2} />
          </div>
        </div>
        <h4>Katalog Digital &amp; Checkout WhatsApp Mandiri</h4>
        <p>Pangkas potongan 10%–20% dari marketplace atau aplikasi ojek online. Pelanggan memesan langsung dari katalog website berkecepatan tinggi, dan pesanan otomatis masuk ke aplikasi WhatsApp kasir Anda dalam format nota terstruktur siap kirim.</p>
      </div>

      <ul class="bento-feature-list">
        <li>
          <span class="bento-check-bullet"><Check size={13} stroke-width={3} /></span>
          <span>Pemesanan instan di HP tanpa unduh aplikasi</span>
        </li>
        <li>
          <span class="bento-check-bullet"><Check size={13} stroke-width={3} /></span>
          <span>Perhitungan varian produk &amp; ongkir otomatis</span>
        </li>
        <li>
          <span class="bento-check-bullet"><Check size={13} stroke-width={3} /></span>
          <span>100% tanpa potongan biaya transaksi (margin utuh)</span>
        </li>
      </ul>
    </div>

    <!-- Card 2 -->
    <div class="bento-card">
      <div>
        <div class="bento-card-top">
          <span class="bento-index">02 / SISTEM KASIR</span>
          <div class="bento-icon-clean">
            <Receipt size={20} stroke-width={2} />
          </div>
        </div>
        <h4>Aplikasi Kasir (POS) Cloud &amp; Cetak Thermal</h4>
        <p>Tinggalkan catatan buku bon manual dan selisih stok yang menyita waktu. Sistem kasir ringan berbasis cloud yang mencatat transaksi harian, mengontrol stok gudang, dan otomatis terhubung ke printer thermal Bluetooth.</p>
      </div>

      <ul class="bento-feature-list">
        <li>
          <span class="bento-check-bullet"><Check size={13} stroke-width={3} /></span>
          <span>Cetak struk via printer thermal Bluetooth</span>
        </li>
        <li>
          <span class="bento-check-bullet"><Check size={13} stroke-width={3} /></span>
          <span>Bisa dibuka dari smartphone, tablet, atau iPad yang ada</span>
        </li>
        <li>
          <span class="bento-check-bullet"><Check size={13} stroke-width={3} /></span>
          <span>Rekap omzet harian otomatis per kasir &amp; per shift</span>
        </li>
      </ul>
    </div>

    <!-- Card 3 -->
    <div class="bento-card">
      <div>
        <div class="bento-card-top">
          <span class="bento-index">03 / KREDIBILITAS &amp; SEO</span>
          <div class="bento-icon-clean">
            <Globe size={20} stroke-width={2} />
          </div>
        </div>
        <h4>Company Profile Resmi &amp; Optimasi Local SEO</h4>
        <p>Mudahkan calon pembeli dan mitra korporat menemukan bisnis Anda saat mencari produk atau jasa di Google Search dan Google Maps kota Anda, lengkap dengan verifikasi legalitas dan portofolio resmi.</p>
      </div>

      <ul class="bento-feature-list">
        <li>
          <span class="bento-check-bullet"><Check size={13} stroke-width={3} /></span>
          <span>Terdaftar di Google Search &amp; Google Maps lokal</span>
        </li>
        <li>
          <span class="bento-check-bullet"><Check size={13} stroke-width={3} /></span>
          <span>Termasuk domain resmi (.com/.id) &amp; sertifikat SSL aman</span>
        </li>
        <li>
          <span class="bento-check-bullet"><Check size={13} stroke-width={3} /></span>
          <span>Tampilan profesional untuk tender B2B &amp; instansi</span>
        </li>
      </ul>
    </div>

    <!-- Card 4 -->
    <div class="bento-card">
      <div>
        <div class="bento-card-top">
          <span class="bento-index">04 / KUSTOMISASI ALUR</span>
          <div class="bento-icon-clean">
            <Settings2 size={20} stroke-width={2} />
          </div>
        </div>
        <h4>Sistem Operasional Kustom Sesuai SOP Bisnis</h4>
        <p>Punya alur kerja unik di tempat produksi catering, sistem antrean reservasi salon, atau servis bengkel kendaraan? Tim engineer Aksara merancang aplikasi web kustom yang pas dengan SOP operasional spesifik Anda.</p>
      </div>

      <ul class="bento-feature-list">
        <li>
          <span class="bento-check-bullet"><Check size={13} stroke-width={3} /></span>
          <span>Dirancang tepat mengikuti kebutuhan SOP kerja nyata</span>
        </li>
        <li>
          <span class="bento-check-bullet"><Check size={13} stroke-width={3} /></span>
          <span>Arsitektur modular yang siap dikembangkan kapan saja</span>
        </li>
        <li>
          <span class="bento-check-bullet"><Check size={13} stroke-width={3} /></span>
          <span>Integrasi database &amp; laporan internal usaha</span>
        </li>
      </ul>
    </div>
  </div>
</section>
